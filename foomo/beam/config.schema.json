{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/foomo/posh-providers/main/foomo/beam/config.schema.json",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Cluster": {
      "properties": {
        "port": {
          "type": "integer"
        },
        "hostname": {
          "type": "string"
        },
        "kubeconfig": {
          "$ref": "#/$defs/Secret"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Config": {
      "properties": {
        "clusters": {
          "additionalProperties": {
            "$ref": "#/$defs/Cluster"
          },
          "type": "object"
        },
        "databases": {
          "additionalProperties": {
            "$ref": "#/$defs/Database"
          },
          "type": "object"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Database": {
      "properties": {
        "port": {
          "type": "integer"
        },
        "hostname": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Secret": {
      "properties": {
        "account": {
          "type": "string",
          "description": "Account is the 1Password account the vault belongs to, as a sign-in\naddress or account UUID."
        },
        "vault": {
          "type": "string",
          "description": "Vault is the name or UUID of the vault holding the item."
        },
        "item": {
          "type": "string",
          "description": "Item is the name or UUID of the item within the vault."
        },
        "field": {
          "type": "string",
          "description": "Field is the name of the field to read from the item, e.g. `password`."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Secret addresses a single field of a 1Password item, in the same terms as an `op://` reference: `op://\u003cvault\u003e/\u003citem\u003e/\u003cfield\u003e`, resolved against Account."
    }
  }
}