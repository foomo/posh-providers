{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foomo/posh-providers/arbitrary/open",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Config": {
      "additionalProperties": {
        "$ref": "#/$defs/ConfigRouter"
      },
      "type": "object"
    },
    "ConfigRoute": {
      "properties": {
        "path": {
          "type": "string",
          "description": "Route path"
        },
        "description": {
          "type": "string",
          "description": "Route description"
        },
        "routes": {
          "additionalProperties": {
            "$ref": "#/$defs/ConfigRoute"
          },
          "type": "object",
          "description": "Child routes"
        },
        "basicAuth": {
          "$ref": "#/$defs/Secret",
          "description": "Basic authentication secret"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "ConfigRouter": {
      "properties": {
        "url": {
          "type": "string",
          "description": "Router base url"
        },
        "routes": {
          "additionalProperties": {
            "$ref": "#/$defs/ConfigRoute"
          },
          "type": "object",
          "description": "Router Child routes"
        },
        "description": {
          "type": "string",
          "description": "Router descriotion"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "Secret": {
      "properties": {
        "account": {
          "type": "string",
          "description": "Account is the 1Password account the vault belongs to, as a sign-in\naddress or account UUID."
        },
        "vault": {
          "type": "string",
          "description": "Vault is the name or UUID of the vault holding the item."
        },
        "item": {
          "type": "string",
          "description": "Item is the name or UUID of the item within the vault."
        },
        "field": {
          "type": "string",
          "description": "Field is the name of the field to read from the item, e.g. `password`."
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Secret addresses a single field of a 1Password item, in the same terms as an `op://` reference: `op://\u003cvault\u003e/\u003citem\u003e/\u003cfield\u003e`, resolved against Account."
    }
  }
}