{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/foomo/posh-providers/main/grafana/gcx/config.schema.json",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Config": {
      "additionalProperties": {
        "$ref": "#/$defs/ConfigEnv"
      },
      "type": "object",
      "description": "Config maps an environment name to the Grafana server, org and credentials gcx is run against."
    },
    "ConfigEnv": {
      "properties": {
        "url": {
          "type": "string",
          "description": "URL of the grafana server"
        },
        "kubeforward": {
          "$ref": "#/$defs/ConfigKubeForward",
          "description": "KubeForward target config"
        },
        "env": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Env to pass to the cli"
        },
        "orgId": {
          "type": "string",
          "description": "OrgID to set"
        },
        "token": {
          "type": "string",
          "description": "Token to set"
        },
        "tokenCmd": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "TokenCmd to execute returning the token"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "ConfigEnv is a single gcx environment: the Grafana server, org, credential source, optional kubeforward target, and extra environment variables passed to the gcx CLI."
    },
    "ConfigKubeForward": {
      "properties": {
        "port": {
          "type": "integer",
          "description": "Port on the target"
        },
        "target": {
          "type": "string",
          "description": "Target pod or service"
        },
        "namespace": {
          "type": "string",
          "description": "Namespace of the target pod or service"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "ConfigKubeForward identifies the pod or service a kubectl port-forward is opened against to reach a Grafana server only reachable from inside the cluster."
    }
  }
}