{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/foomo/posh-providers/main/grafana/gcx/config.schema.json",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Config": {
      "additionalProperties": {
        "$ref": "#/$defs/ConfigEnv"
      },
      "type": "object",
      "description": "Config maps an environment name to the Grafana server, org and credentials gcx is run against."
    },
    "ConfigEnv": {
      "properties": {
        "url": {
          "type": "string",
          "description": "URL of the grafana server"
        },
        "env": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Env to pass to the cli"
        },
        "orgId": {
          "type": "string",
          "description": "OrgID to set"
        },
        "token": {
          "type": "string",
          "description": "Token to set"
        },
        "tokenCmd": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "TokenCmd to execute returning the token"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}