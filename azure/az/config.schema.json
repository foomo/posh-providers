{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/foomo/posh-providers/main/azure/az/config.schema.json",
  "$ref": "#/$defs/Config",
  "$defs": {
    "Artifactory": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the artifactory"
        },
        "resourceGroup": {
          "type": "string",
          "description": "ResourceGroup of the artifactory"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Artifactory identifies an Azure Container Registry by name and resource group."
    },
    "Cluster": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the cluster"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group of the cluster"
        },
        "proxyUrl": {
          "type": "string",
          "description": "ProxyURL to use for the kubeconfig"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Cluster identifies an AKS cluster by name, resource group, and an optional proxy URL to write into its retrieved kubeconfig."
    },
    "Config": {
      "properties": {
        "configPath": {
          "type": "string",
          "description": "Config path"
        },
        "tenantId": {
          "type": "string",
          "description": "Tenant id"
        },
        "proxy": {
          "type": "string",
          "description": "Named SSH proxy for az login (tenant-level commands)"
        },
        "subscriptions": {
          "additionalProperties": {
            "$ref": "#/$defs/Subscription"
          },
          "type": "object",
          "description": "Subscription configurations"
        },
        "servicePrincipals": {
          "additionalProperties": {
            "$ref": "#/$defs/ServicePrincipal"
          },
          "type": "object",
          "description": "Authentication service principals"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Config holds the Azure CLI's local config directory, tenant and the subscriptions and service principals available to the az command."
    },
    "ServicePrincipal": {
      "properties": {
        "tenantId": {
          "type": "string",
          "description": "Tenant id"
        },
        "clientId": {
          "type": "string",
          "description": "Application client id"
        },
        "clientSecret": {
          "type": "string",
          "description": "Application password"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "ServicePrincipal holds the credentials for a non-interactive `az login`."
    },
    "Subscription": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the subscription"
        },
        "vaults": {
          "additionalProperties": {
            "$ref": "#/$defs/Vault"
          },
          "type": "object",
          "description": "Vaults available within the subscription"
        },
        "clusters": {
          "additionalProperties": {
            "$ref": "#/$defs/Cluster"
          },
          "type": "object",
          "description": "Clusters available within the subscription"
        },
        "artifactories": {
          "additionalProperties": {
            "$ref": "#/$defs/Artifactory"
          },
          "type": "object",
          "description": "Artifactorys available within the subscription"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Subscription holds an Azure subscription's name and the vaults, clusters and artifactories configured within it."
    },
    "Vault": {
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the key vault"
        },
        "resourceGroup": {
          "type": "string",
          "description": "Resource group of the key vault"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "description": "Vault identifies an Azure Key Vault by name and resource group."
    }
  }
}